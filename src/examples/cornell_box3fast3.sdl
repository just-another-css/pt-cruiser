"lightdiffuse": "light_diffuse" [ ]
"diffuse": "dark_diffuse" [ ]
"reddiffuse": "light_diffuse" [ texture = "textures/red.png" ]
"greendiffuse": "light_diffuse" [ texture = "textures/green.png" ]
"light": "light_source" [ ]
"glass": "glass" [ ]
"metal": "metal" [ smoothness = 1.0, roughness = 0.0001 ]
-x_res 1280
-y_res 720
-x_fov 1.2
-pixel_ray_grid_dim 1
-ray_bounce_limit 6
-cam_pos (0.0,0.0,0.0)
-cam_dir (0.0,0.0,1.0)
-cam_up  (0.0,1.0,0.0)